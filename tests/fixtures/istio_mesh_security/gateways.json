{
  "apiVersion": "networking.istio.io/v1",
  "items": [
    {
      "apiVersion": "networking.istio.io/v1",
      "kind": "Gateway",
      "metadata": {
        "name": "legacy-admin",
        "namespace": "ingress",
        "uid": "00000000-0000-0000-0000-000000000019"
      },
      "spec": {
        "selector": {
          "istio": "ingressgateway"
        },
        "servers": [
          {
            "hosts": [
              "admin.example.com"
            ],
            "port": {
              "name": "http-admin",
              "number": 8080,
              "protocol": "HTTP"
            }
          },
          {
            "hosts": [
              "old.example.com"
            ],
            "port": {
              "name": "https-old",
              "number": 8443,
              "protocol": "HTTPS"
            },
            "tls": {
              "credentialName": "old-cert",
              "minProtocolVersion": "TLSV1_0",
              "mode": "SIMPLE"
            }
          }
        ]
      }
    },
    {
      "apiVersion": "networking.istio.io/v1",
      "kind": "Gateway",
      "metadata": {
        "name": "public",
        "namespace": "ingress",
        "uid": "00000000-0000-0000-0000-000000000020"
      },
      "spec": {
        "selector": {
          "istio": "ingressgateway"
        },
        "servers": [
          {
            "hosts": [
              "*.example.com"
            ],
            "port": {
              "name": "https",
              "number": 443,
              "protocol": "HTTPS"
            },
            "tls": {
              "credentialName": "public-cert",
              "minProtocolVersion": "TLSV1_2",
              "mode": "SIMPLE"
            }
          },
          {
            "hosts": [
              "*.example.com"
            ],
            "port": {
              "name": "http",
              "number": 80,
              "protocol": "HTTP"
            },
            "tls": {
              "httpsRedirect": true
            }
          }
        ]
      }
    }
  ],
  "kind": "GatewayList",
  "metadata": {
    "continue": ""
  }
}