{
  "apiVersion": "apps/v1",
  "items": [
    {
      "metadata": {
        "labels": {
          "app": "istiod",
          "istio.io/rev": "default"
        },
        "name": "istiod",
        "namespace": "istio-system",
        "uid": "00000000-0000-0000-0000-000000000027"
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "istiod"
          }
        },
        "strategy": {
          "rollingUpdate": {
            "maxSurge": "25%",
            "maxUnavailable": "25%"
          },
          "type": "RollingUpdate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "istiod"
            }
          },
          "spec": {
            "containers": [
              {
                "env": [
                  {
                    "name": "DEFAULT_WORKLOAD_CERT_TTL",
                    "value": "12h"
                  }
                ],
                "image": "docker.io/istio/pilot:1.32.0",
                "imagePullPolicy": "IfNotPresent",
                "name": "discovery",
                "resources": {},
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File"
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 30
          }
        }
      },
      "status": {}
    }
  ],
  "kind": "DeploymentList",
  "metadata": {}
}