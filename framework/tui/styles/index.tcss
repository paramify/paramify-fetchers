/* TUI styles. Layout + chrome; colors come from the tokyo-night theme. */

/* ---- global widget language (Posting-style) ----
   Thin $primary-tinted scrollbars; dense one-row inputs and buttons whose
   focus is an accent left edge (padding swaps for the border so text never
   shifts); muted-bold table headers. */
* {
    scrollbar-color: $primary 10%;
    scrollbar-color-hover: $primary 80%;
    scrollbar-color-active: $primary;
    scrollbar-background: $surface-darken-1;
    scrollbar-size-vertical: 1;
}
*:focus {
    scrollbar-color: $primary 50%;
}

Input {
    height: 1;
    border: none;
    padding: 0 1;
    background: $surface;
}
Input:focus {
    border: none;
    border-left: wide $primary;
    padding-left: 0;
    background: $surface;
}

/* Flatten Button's tall top/bottom borders in every state (base, hover,
   active, variants) so buttons sit on one row like the inputs. */
Button, Button:hover, Button.-active,
Button.-primary, Button.-primary:hover, Button.-primary.-active,
Button.-error, Button.-error:hover, Button.-error.-active {
    border: none;
}
Button {
    height: 1;
    min-width: 12;
    padding: 0 2;
    background: $panel;
}
Button.-primary {
    background: $primary-muted;
    color: $text-primary;
}
Button.-primary:hover {
    background: $primary-darken-2;
}
Button.-error {
    background: $error-muted;
    color: $text-error;
}

/* Tables sit on the page: the panel border is the only outline. */
DataTable {
    background: transparent;
}
DataTable > .datatable--header {
    background: transparent;
    color: $text-muted;
    text-style: bold;
}
/* Only the list that has focus shows the bright cursor. */
DataTable:blur > .datatable--cursor {
    background: $panel;
    color: $text;
    text-style: none;
}

RichLog {
    background: transparent;
    padding: 0 1;
}
RichLog:focus {
    border-left: wide $primary;
    padding-left: 0;
}

/* ---- shared chrome: header bar, footer hint bar, focus-aware panels ---- */
#app-header {
    height: auto;
    border-bottom: solid $panel;
    padding: 0 1;
}
#app-header-left { width: auto; }
#app-header-crumb { width: 1fr; text-align: center; color: #7DCFFF; }
#app-header-clock { width: auto; color: $text-muted; }

#app-footer {
    height: auto;
    border-top: solid $panel;
    padding: 0 1;
}

TabbedContent {
    height: 1fr;
}

/* A titled box whose border highlights when it (or a child) holds focus.
   Titles live in the border (border_title, set by each screen) — a gray
   border at rest, so only the focused panel has the accent and a bold title. */
.panel {
    border: round $foreground 18%;
    border-title-color: $text-muted;
    border-title-align: right;
    padding: 0 1;
}
.panel:focus-within {
    border: round $primary;
    border-title-color: $text;
    border-title-style: bold;
}
/* In-content section label (modal right column etc.). */
.panel-title {
    color: $text-muted;
    text-style: bold;
}

/* Hatched empty states: tag a .panel with .empty to swap its table/log for
   the instructional .empty-hint placeholder (Posting's empty-state idiom). */
.empty-hint {
    display: none;
    height: 1fr;
    color: $text-muted;
    hatch: right $surface-lighten-1 50%;
    content-align: center middle;
    text-align: center;
    padding: 1 4;
}
.panel.empty > .empty-hint {
    display: block;
}
.panel.empty > DataTable, .panel.empty > RichLog {
    display: none;
}

/* ---- Catalog ---- */
CatalogPanel { height: 1fr; padding: 1 1 0 1; }

#catalog-left { width: 42%; min-width: 32; }
#catalog-search { margin: 1 0; }
#catalog-tree {
    height: 1fr;
    background: transparent;
}
#catalog-tree > .tree--cursor { background: $primary; color: $background; text-style: bold; }
#catalog-tree:blur > .tree--cursor { background: $panel; color: $text; text-style: none; }
/* While the filter has focus, up/down and enter drive the tree cursor, so it
   stays bright as long as focus is anywhere in the catalog. */
#catalog-left:focus-within #catalog-tree > .tree--cursor { background: $primary; color: $background; text-style: bold; }
#catalog-tree > .tree--guides { color: $panel; }

#catalog-detail-scroll { width: 1fr; margin-left: 1; }

/* ---- Fetchers: catalog and detail on top, the manifest across the bottom ---- */
FetchersPage { height: 1fr; padding: 1 1 0 1; }
#fetchers-top { height: 1fr; min-height: 8; }
#catalog-panel { width: 45%; height: 1fr; padding: 0; }
#catalog-panel #catalog-left { width: 1fr; }
#fetchers-detail-scroll { width: 1fr; margin-left: 1; }
/* Its height is set from the row count (FetchersPage._fit_manifest). */
#manifest-panel { height: 16; }
#manifest-panel #manifest-top { padding: 1 0 0 0; }
#manifest-panel #manifest-body { padding: 0; }
/* Buttons fit their labels, so the output dir keeps room to show a path. */
#manifest-panel #manifest-top Button { width: auto; min-width: 7; }
#manifest-panel #manifest-output-dir { min-width: 16; }
/* A short page drops its blank rows, so the catalog and the manifest
   keep more of their rows (FetchersPage.SHORT_PAGE). */
FetchersPage.short #catalog-search { margin: 0; }
FetchersPage.short #manifest-panel #manifest-top { padding: 0; }
FetchersPage.short #manifest-empty-hint { padding: 0 4; }

/* Manifest editor */
ManifestPanel {
    height: 1fr;
}

#manifest-top {
    height: auto;
    padding: 1 1 0 1;
    align: left middle;
}

#manifest-top .inline-label {
    width: auto;
    padding: 0 1 0 0;
}

#manifest-top .after-button {
    margin-left: 2;
}

#manifest-output-dir {
    width: 1fr;
}

#manifest-top Button {
    margin-left: 1;
}

#manifest-body {
    height: 1fr;
    padding: 1 1 0 1;
}

#manifest-entries-panel { width: 55%; }
ManifestPanel.no-detail #manifest-entries-panel { width: 1fr; }
#manifest-entries { height: 1fr; }

#manifest-detail-scroll {
    width: 1fr;
    margin-left: 1;
}

#manifest-issues {
    height: auto;
    border-top: solid $panel;
    padding: 0 1;
}

/* Run console */
RunPage {
    height: 1fr;
}

#run-top {
    height: auto;
    padding: 1 1 0 1;
    align: left middle;
}

#run-banner {
    width: 1fr;
    padding: 0 0 0 2;
}

#run-body {
    height: 1fr;
    padding: 1 1 0 1;
}

#run-status-panel { width: 50%; }
#run-log-panel { width: 1fr; margin-left: 1; }
#run-status, #run-log { height: 1fr; }

#run-summary {
    height: auto;
    border-top: solid $panel;
    padding: 0 1;
}

/* Evidence browser */
EvidencePage {
    height: 1fr;
}

#evidence-top {
    height: auto;
    padding: 1 1 0 1;
    align: left middle;
}

#evidence-dir {
    width: 1fr;
}

#evidence-body {
    height: 1fr;
    padding: 1 1 0 1;
}

#evidence-left { width: 38%; }
#evidence-right { width: 1fr; margin-left: 1; }

#evidence-runs, #evidence-files { height: 1fr; }

/* Prose that wraps under a summary table (the Pipelines send panel's
   preflight errors and warnings). */
.panel-notes { height: auto; padding: 0 1; }

/* Pipelines send panel: sized to content, so a run with no scan reports
   collapses to a single "collected none" line instead of holding open space. */
#issues-panel { height: auto; margin: 1 1 0 1; }
#issues-summary { height: auto; }
#issues-actions { height: auto; align: left middle; padding-top: 1; }
#issues-actions Button { width: 24; }

/* Paramify: a setup grid of what each manifest fetcher has in Paramify. The grid
   takes the free height; the row under it (the detail, or an action's log) is
   sized from Python, and gives way on a short terminal. */
ParamifyPage { height: 1fr; padding: 0 1; }
#pf-summary { height: auto; padding: 0 1; margin-top: 1; }
#pf-summary.problem { color: $warning; border-left: tall $warning; }
#pf-activity-panel { height: 13; margin-top: 1; }
#pf-log { height: 1fr; }
#pf-lens-tabs { margin-top: 1; }
#pf-lens { height: 1fr; }
#pf-by-fetcher, #pf-by-capability { height: 1fr; }
#pf-grid-panel { height: 1fr; min-height: 8; }
#pf-filter { margin-bottom: 1; }
#pf-grid { height: 1fr; }
#pf-totals { height: 2; padding: 0 1; border-top: solid $panel; }
#pf-detail { height: 13; margin-top: 1; }
#pf-set-panel { width: 46%; }
#pf-caps-panel { width: 1fr; margin-left: 1; }
#pf-caps { height: 1fr; }
.panel.empty > #pf-totals, .panel.empty > #pf-filter { display: none; }
#pf-cap-panel { height: 1fr; min-height: 8; }
#pf-cap-filter { margin-bottom: 1; }
#pf-cap-grid { height: 1fr; }
#pf-cap-error { height: 1fr; padding: 1 2; }
#pf-cap-hint { height: auto; padding: 0 1; }
#pf-pairs-panel { height: 8; margin-top: 1; }
#pf-pairs { height: 1fr; }
/* A short terminal drops the blank rows, so the list keeps its rows (the row
   under it gives way, sized from Python). */
ParamifyPage.short #pf-summary, ParamifyPage.short #pf-lens-tabs { margin-top: 0; }
ParamifyPage.short #pf-filter { margin-bottom: 0; }
ParamifyPage.short #pf-totals { height: 1; border-top: none; }
ParamifyPage.short #pf-detail, ParamifyPage.short #pf-activity-panel { margin-top: 0; }
ParamifyPage.short #pf-grid-panel { min-height: 0; }
/* The view bar gives its two rows to the list; [ and ] still switch views,
   and the list's title says which one shows. */
ParamifyPage.short #pf-lens-tabs { display: none; }
ParamifyPage.short #pf-cap-filter { margin-bottom: 0; }
ParamifyPage.short #pf-pairs-panel { margin-top: 0; }
ParamifyPage.short #pf-cap-panel { min-height: 0; }

/* Pipelines: the scan-report fetchers, the send panel and its log. */
PipelinesPage {
    height: 1fr;
}
#pipelines-fetchers-panel { height: auto; max-height: 12; margin: 1 1 0 1; }
#pipelines-fetchers { height: auto; max-height: 10; }
#pipelines-log-panel { height: 1fr; min-height: 6; margin: 1 1 0 1; }
#pipelines-log { height: 1fr; }
#pipelines-banner {
    height: auto;
    padding: 0 1;
}

/* Modals */
ModalScreen {
    align: center middle;
}

#modal-card {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#modal-card.confirm {
    width: 72;
}

/* A Label sizes to its text and clips what does not fit: a long question lost
   its second sentence — the one saying a close auto-closes open issues. Full
   width makes it wrap inside the card instead. */
#modal-card.confirm #modal-title {
    width: 100%;
}

#modal-card.wide {
    width: 110;
    max-width: 95%;
    height: 85%;
}

#modal-title {
    text-style: bold;
}

#modal-subtitle {
    color: $text-muted;
    padding-bottom: 1;
}

/* Why a picker's list is short: no token, an API error. */
#picker-notice {
    color: $warning;
    border-left: tall $warning;
    padding: 0 1;
    margin-bottom: 1;
}

#modal-body {
    height: auto;
    max-height: 24;
    padding: 1 0;
}

/* The preview card is tall (85%); its body should fill and scroll, not cap at
   the 24-row form default that leaves the lower half of the card empty. */
#modal-card.wide #modal-body {
    height: 1fr;
    max-height: 100%;
}

/* Targets editor: the table fills the wide card, with the count and the key
   legend pinned under it. */
#targets-table {
    height: 1fr;
    margin-top: 1;
}

#targets-count {
    color: $text-muted;
    padding-top: 1;
}

#targets-keys {
    color: $text-muted;
}

#preview-text {
    width: 1fr;
}

#modal-buttons {
    height: auto;
    align-horizontal: right;
    padding-top: 1;
}

#modal-buttons Button {
    margin-left: 2;
}

.group-label {
    text-style: bold;
    color: $accent;
    padding-top: 1;
}

.field-row {
    height: auto;
    padding-bottom: 1;
}

.field-note {
    color: $text-muted;
    text-style: italic;
}

#field-input {
    width: 1fr;
}

.patterns-input {
    height: 6;
}

#picker-list {
    height: 16;
    margin-top: 1;
}

/* A notice's single fallback choice: no filter above it, no empty list below it. */
#picker-list.fallback {
    height: auto;
    margin-top: 0;
}

