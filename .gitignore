# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtualenv ---
.venv/
venv/

# --- Secrets: NEVER commit ---
# The framework resolves ${env:VAR} from the environment; .env is one source
# among many and must stay local.
.env
.env.*
!.env.example

# --- Customer-side sync state (validator key -> Paramify id); never commit ---
.paramify/

# --- Generated collect output (runner writes evidence/run-<timestamp>/) ---
/evidence/

# --- Run manifests are NOT ignored ---
# Your manifests describe which evidence you collect, so most teams want them in
# version control — the manifest builder's ./manifest.yaml default and anything
# under manifests/ are yours to commit or leave untracked, as you prefer. They
# hold no secret values: `${env:VAR}` is resolved from the environment at run
# time, so a manifest names its secrets without containing them.
#
# Nothing is ignored here on purpose. This repo ships example_manifest.yaml as a
# reference sample and nothing at ./manifest.yaml, so a manifest you create is
# never in conflict with one of ours.

# --- Claude Code: ignore personal settings, keep shared skills + settings.json ---
.claude/settings.local.json
.claude/tmp/

# --- Terraform: never commit the local provider cache or state ---
# .terraform/ holds platform-specific provider binaries (hundreds of MiB);
# .terraform.lock.hcl IS committed (it pins provider versions).
.terraform/
*.tfstate
*.tfstate.*

# --- TUI design preview renders (regenerable; open locally) ---
*_mock.svg

# --- VHS demo recordings ---
# The .gif files ARE committed — they are what the README embeds. Everything used to
# produce them is local: the tapes, the render script, and the synthetic `demo`
# fetchers and manifest they record against. Keeping them out means a clean clone
# cannot re-render the GIFs; whoever records them needs these files locally.
docs/demo/.scratch/
docs/demo/*.tape
docs/demo/render.sh
docs/demo/README.md
manifests/demo.yaml
fetchers/demo/README.md
fetchers/demo/access_review/
fetchers/demo/audit_logging/
fetchers/demo/encryption_at_rest/
fetchers/demo/vuln_scan/

# --- EKS demo deploy bundle (demo-only, NOT public) ---
# Restored from 549b98a^ for the live customer demo. Commit 549b98a deliberately
# removed deploy/k8s/ from the public tree ("we don't want to prescribe that level
# of deployment"), and that call stands — this is presenter-local material only.
# Recover it again with: git checkout 549b98a^ -- deploy/k8s/
deploy/k8s/

# --- ECS/Fargate demo deploy bundle (demo-only, NOT public) ---
# Same call as deploy/k8s/ above: presenter-local material, not deployment advice
# we want to prescribe in the public tree. Also holds secrets.json (real
# credentials), which .dockerignore keeps out of the image but only this keeps
# out of git.
deploy/ecs/

# --- Claude Code agent worktrees (tool-generated; each is its own git repo) ---
.claude/worktrees/

# --- macOS / editors ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Manifests ---
manifests/*

# Downloaded third-party CrowdStrike response captures (tools/crowdstrike_corpus.py)
tests/fixtures/crowdstrike_corpus/
