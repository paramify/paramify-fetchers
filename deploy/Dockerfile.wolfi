# Beta deployment image for the paramify fetchers, built on Chainguard Wolfi.
#
# This is the second of two images. deploy/Dockerfile is the Debian image
# (python:3.14-slim) and stays the default until this one replaces it. Keep the
# two in step: the same tools, settings and ENV lines.
#
# It bundles the tool, its Python deps, AND the system binaries the fetchers
# shell out to (pip does NOT install those):
#   jq (41 fetchers), aws-cli (33), kubectl (3 k8s), git (checkov clone), curl, checkov.
#
# Build (from the REPO ROOT, not deploy/):
#   docker build -f deploy/Dockerfile.wolfi -t paramify-fetchers:beta .
# or with docker compose: set PARAMIFY_DOCKERFILE=Dockerfile.wolfi (see
# deploy/docker-compose.yml).
#
# The base is Chainguard's Wolfi base image: a minimal, glibc-based image that
# Chainguard rebuilds daily, so it carries far fewer known CVEs than Debian.
# Chainguard's free `python` image only has a `latest` tag, and that tag moves
# to each new Python minor. So we start from wolfi-base and install a fixed
# Python minor from the Wolfi package repo. The digest pin makes builds
# repeatable; Dependabot bumps it (see .github/dependabot.yml).
#
# Two stages. The `build` stage has pip and creates the virtualenvs. The final
# stage gets only the virtualenvs and the code, so pip and apk are not in the
# image that runs. Nothing in the container installs packages: `paramify
# update` stops at PARAMIFY_CONTAINER (below).
ARG WOLFI_BASE=cgr.dev/chainguard/wolfi-base:latest@sha256:be019c1c74fe69204a42c4e10bc4d886a49bf5403ffa74374ef7baa408fc9a26

# ===========================================================================
# Stage 1: build the virtualenvs
# ===========================================================================
FROM ${WOLFI_BASE} AS build

# python-3.14: keep in step with the newest Python in CI (.github/workflows/ci.yml)
# and with the python-3.14 package in the final stage. The virtualenvs link to
# /usr/bin/python3.14, so both stages must install the same Python minor.
RUN apk add --no-cache python-3.14 py3.14-pip

# tui extra → `paramify tui` works inside the container; checkov extra → the
# checkov scanner fetchers; aws extra → boto3 for the Inspector ECR fetchers.
# Toggle for faster local builds:
#   docker build --build-arg INSTALL_EXTRAS=tui ...
ARG INSTALL_EXTRAS=tui,checkov,aws

# The checkov fetchers run the `checkov` CLI, so checkov gets its own virtualenv
# with only its executable on PATH. It pins exact versions of libraries the
# other fetchers also use (boto3), which would otherwise hold them back.
# It does not use the repo code, so it comes before COPY: a code change does
# not reinstall checkov.
RUN case ",${INSTALL_EXTRAS}," in \
      *,checkov,*) \
        python3.14 -m venv /opt/checkov \
        && /opt/checkov/bin/pip install --no-cache-dir checkov \
        && /opt/checkov/bin/pip uninstall -y pip ;; \
    esac

# A virtualenv first on PATH gives `python` and `paramify` stable names,
# whatever the Wolfi Python package links into /usr/bin. The install is
# editable, so the final stage must put the code at the same path (/app).
WORKDIR /app
COPY . .
RUN python3.14 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -e ".[${INSTALL_EXTRAS}]" \
    && /opt/venv/bin/pip uninstall -y pip
RUN chmod +x deploy/entrypoint.sh deploy/run-and-upload.sh 2>/dev/null || true

# ===========================================================================
# Stage 2: the image that runs
# ===========================================================================
FROM ${WOLFI_BASE}

# System binaries. pip is not here; see the build stage.
# coreutils/grep/sed/gawk/findutils: the GNU tools. wolfi-base has only busybox,
#   and the bash fetchers were written against the GNU versions.
# aws-cli-2: the current AWS CLI v2. (The `aws-cli-v2` package is an old build.)
# kubectl-latest: the newest kubectl, as the old curl from stable.txt gave.
# supercronic: the scheduler for `scheduler` mode (see entrypoint.sh). It runs as
#   a non-root user and passes the container's environment to each job.
# The last step removes apk itself, so nothing can add packages at run time.
# `apk del` (not rm) keeps the package database correct, and image scanners
# read that database to list what is installed. The `wolfi-base` package
# depends on apk-tools, so it goes too; without it, `apk del` keeps apk-tools
# and still exits 0. The final check fails the build if apk is still here.
RUN apk add --no-cache \
        python-3.14 \
        bash coreutils grep sed gawk findutils tzdata \
        git curl jq \
        aws-cli-2 kubectl-latest \
        tini supercronic \
    && apk del --no-cache wolfi-base apk-tools \
    && [ ! -e /usr/bin/apk ] && [ ! -e /sbin/apk ]

# NOTE: one fetcher references `terraform`. Checkov *scans* terraform source
# statically and does not need the binary; add the Wolfi `terraform` package
# only if a fetcher actually invokes terraform.

COPY --from=build /opt /opt
COPY --from=build /app /app
RUN if [ -x /opt/checkov/bin/checkov ]; then \
      mkdir -p /usr/local/bin && ln -s /opt/checkov/bin/checkov /usr/local/bin/checkov; \
    fi

ENV PATH=/opt/venv/bin:$PATH
# The python:*-slim images set this, and the fetchers were tested under it.
# wolfi-base sets no locale; glibc has C.UTF-8 built in.
ENV LANG=C.UTF-8
WORKDIR /app

# Tells `paramify update` it is running in this image. The image is a copy of
# the clone with no .git (see .dockerignore), so there is nothing to update in
# here: update the clone on the host, then rebuild the image.
ENV PARAMIFY_CONTAINER=1

# Collected evidence lands here; mount a volume to persist it to the host.
ENV EVIDENCE_DIR=/app/evidence
VOLUME ["/app/evidence"]

COPY --from=build /app/deploy/entrypoint.sh /usr/local/bin/entrypoint.sh

# Run as wolfi-base's `nonroot` user, not root. The code in /app stays owned by
# root and read-only to it. The user can write only where the tool writes:
# evidence/ (run output) and manifests/ (what `paramify tui` saves).
# The UID is numeric so that Kubernetes `runAsNonRoot` can verify it.
# A host folder mounted on /app/evidence must be writable by UID 65532; see
# deploy/README.md.
RUN mkdir -p /app/evidence /app/manifests \
    && chown -R 65532:65532 /app/evidence /app/manifests
USER 65532:65532

# tini = clean PID-1 signal handling (matters for the cron scheduler mode).
# Exec-form resolves `tini` via PATH, so it works wherever the package installs it.
ENTRYPOINT ["tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["paramify", "list"]
